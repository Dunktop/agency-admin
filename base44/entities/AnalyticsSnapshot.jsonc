{
  "name": "AnalyticsSnapshot",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "description": "Client record id"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "views": {
      "type": "number"
    },
    "subscribers": {
      "type": "number"
    },
    "watchHours": {
      "type": "number"
    },
    "impressionsCTR": {
      "type": "number"
    },
    "topVideos": {
      "type": "string",
      "maxLength": 20000,
      "description": "JSON list of top videos"
    }
  },
  "required": [
    "client",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}