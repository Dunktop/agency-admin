{
  "name": "ClientProgress",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "description": "Client record id"
    },
    "stage": {
      "type": "string",
      "enum": [
        "WAITING_FOR_FOOTAGE",
        "FILMING",
        "EDITING_SHORT_FORM",
        "EDITING_LONG_FORM",
        "DESIGNING_THUMBNAIL",
        "IN_REVIEW",
        "UPLOADING",
        "PUBLISHED"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "purple",
        "pink",
        "yellow",
        "blue",
        "green"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "MANUAL",
        "AI_DISCORD"
      ],
      "enumColors": [
        "gray",
        "teal"
      ],
      "default": "MANUAL"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "client",
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}